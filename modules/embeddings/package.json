{
  "name": "@conduitplatform/embeddings",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "conduit": {
    "peers": {
      "await": ["database"],
      "watch": [{ "module": "database", "edge": "rising" }]
    }
  },
  "scripts": {
    "start": "node dist/index.js",
    "prebuild": "npm run generateTypes",
    "build": "rimraf dist && tsc",
    "postbuild": "copyfiles -u 1 src/**/*.proto src/*.proto ./dist/",
    "generateTypes": "sh build.sh"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.10.2",
    "@conduitplatform/grpc-sdk": "workspace:*",
    "@conduitplatform/module-tools": "workspace:*",
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.0",
    "bullmq": "^5.21.2",
    "convict": "^6.2.5",
    "ioredis": "^5.10.1",
    "lodash-es": "^4.18.1"
  },
  "devDependencies": {
    "@types/convict": "^6.1.6",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "24.9.1",
    "copyfiles": "^2.4.1",
    "rimraf": "^6.1.3",
    "ts-proto": "^2.11.6",
    "typescript": "~6.0.2"
  }
}
