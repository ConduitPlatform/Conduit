{
  "name": "@conduitplatform/chat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "bundle/index.js",
  "engines": {
    "node": ">=24"
  },
  "conduit": {
    "peers": {
      "await": [
        "database"
      ],
      "watch": [
        {
          "module": "authentication",
          "edge": "both"
        },
        {
          "module": "router",
          "edge": "rising"
        }
      ]
    }
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.0",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@sesamecare-oss/redlock": "^1.4.0",
    "abort-controller-x": "^0.5.0",
    "axios": "1.18.0",
    "convict": "^6.2.5",
    "escape-string-regexp": "^5.0.0",
    "express": "^5.2.1",
    "fast-jwt": "^6.2.4",
    "fs-extra": "^11.3.5",
    "ioredis": "^5.11.1",
    "lodash": "^4.18.1",
    "lodash-es": "^4.18.1",
    "nice-grpc": "^2.1.16",
    "nice-grpc-client-middleware-retry": "^3.1.15",
    "nice-grpc-common": "^2.0.3",
    "prom-client": "^15.1.3",
    "protobufjs": "^8.7.1",
    "snappy": "7.3.3",
    "uuid": "^14.0.1",
    "winston": "^3.19.0",
    "winston-loki": "^6.1.4"
  }
}
